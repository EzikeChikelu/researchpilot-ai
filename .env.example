# Frontend: set in apps/web/.env.local. The Next.js server proxies API calls.
API_URL=http://127.0.0.1:8000
# Optional browser-facing URL for direct API testing only; the UI does not need it.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend: keep private; configure in apps/api/.env or hosting environment
# Get a Tavily API key from https://tavily.com/
# TAVILY_API_KEY=

# Optional: enable AI report synthesis using an OpenAI-compatible chat completions API
# Get an API key from your chosen model provider; never use NEXT_PUBLIC_ for secrets.
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# Future features
# DATABASE_URL=
